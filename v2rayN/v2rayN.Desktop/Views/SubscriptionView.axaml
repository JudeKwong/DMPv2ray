<UserControl
    x:Class="v2rayN.Desktop.Views.SubscriptionView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="600"
    d:DesignWidth="900"
    x:DataType="vms:SubSettingViewModel"
    Design.DataContext="{x:Static dd:DesignData.SubSetting}"
    mc:Ignorable="d">
    <DockPanel>
        <!-- ===== 工具栏 ===== -->
        <Border
            DockPanel.Dock="Top"
            Padding="10,8"
            Background="{DynamicResource SemiColorFill1}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="0,0,0,1">
            <WrapPanel>
                <Button
                    x:Name="btnAddSub"
                    Margin="0,0,8,0"
                    Classes="Primary"
                    Content="{x:Static resx:ResUI.menuSubAdd}" />
                <Button
                    x:Name="btnEditSub"
                    Margin="0,0,8,0"
                    Content="{x:Static resx:ResUI.menuSubEdit}" />
                <Button
                    x:Name="btnDeleteSub"
                    Margin="0,0,8,0"
                    Content="{x:Static resx:ResUI.menuSubDelete}" />
                <Button
                    x:Name="btnShareSub"
                    Margin="0,0,8,0"
                    Content="{x:Static resx:ResUI.menuSubShare}" />
                <Button
                    x:Name="btnUpdateAll"
                    Margin="0,0,8,0"
                    Content="{x:Static resx:ResUI.SubUpdateAll}" />
                <Button
                    x:Name="btnUpdateCurrent"
                    Margin="0,0,8,0"
                    Content="{x:Static resx:ResUI.SubUpdateCurrent}" />
            </WrapPanel>
        </Border>

        <!-- ===== 订阅列表 ===== -->
        <DataGrid
            x:Name="lstSubscription"
            Margin="12,10"
            AutoGenerateColumns="False"
            BorderThickness="1"
            CanUserResizeColumns="True"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{Binding SubItems}"
            SelectedItem="{Binding SelectedSource, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="2*"
                    Binding="{Binding Remarks}"
                    Header="{x:Static resx:ResUI.SubColName}" />
                <DataGridTextColumn
                    Width="4*"
                    Binding="{Binding Url}"
                    Header="{x:Static resx:ResUI.SubColUrl}" />



            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>



